# Backend
APP_ENV=development
DATABASE_URL=sqlite:///../data/local_route_agent.db

# LLM provider: openai or deepseek
LLM_PROVIDER=openai
OFOX_API_KEY=
OPENAI_API_KEY=""
OPENAI_MODEL=openai/gpt-5.6-sol
OPENAI_BASE_URL=https://api.ofox.ai/v1
# Optional HTTP proxy used only by outbound LLM requests.
LLM_PROXY_URL=
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=deepseek-chat

# Amap Web Service API key. Used by backend route-leg enrichment.
AMAP_WEB_SERVICE_KEY=""
# Route provider: mock, amap, or fallback. Demo/dev should use mock.
MAP_ROUTE_PROVIDER=mock
PLANNING_PIPELINE_MODE=
PLANNING_PIPELINE_ROLLOUT_PERCENT=100
ROUTE_MODEL_ENABLED=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_CHAT=false
AGENT_RUNTIME_VERSION=v1
