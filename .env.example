# Backend
APP_ENV=development
DATABASE_URL=sqlite:///../data/local_route_agent.db

# LLM provider: openai or deepseek
LLM_PROVIDER=openai
OPENAI_API_KEY=""
OPENAI_MODEL=openai/gpt-5.4-mini
OPENAI_BASE_URL=https://api.ofox.ai/v1
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=deepseek-chat

# Amap Web Service API key. Used by backend route-leg enrichment.
AMAP_WEB_SERVICE_KEY=""
# Route provider: mock, amap, or fallback. Demo/dev should use mock.
MAP_ROUTE_PROVIDER=mock

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_CHAT=false
